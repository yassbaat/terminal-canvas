{
  "name": "terminal-canvas",
  "version": "0.1.0",
  "description": "Infinite-canvas terminal workspace for managing multiple coding-agent sessions",
  "main": "./dist/main/index.cjs",
  "author": "Terminal Canvas Team",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "vue-tsc --noEmit",
    "dev": "npm-run-all --parallel dev:*",
    "dev:main": "vite build --watch --config vite.main.config.ts",
    "dev:preload": "vite build --watch --config vite.preload.config.ts",
    "dev:renderer": "vite --config vite.renderer.config.ts",
    "dev:electron": "wait-on http-get://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "build": "npm run typecheck && npm run build:main && npm run build:preload && npm run build:renderer",
    "build:main": "vite build --config vite.main.config.ts",
    "build:preload": "vite build --config vite.preload.config.ts",
    "build:renderer": "vite build --config vite.renderer.config.ts",
    "electron": "electron .",
    "start": "npm run build && npm run electron",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "postinstall": "electron-builder install-app-deps"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue-flow/background": "^1.3.0",
    "@vue-flow/controls": "^1.1.0",
    "@vue-flow/core": "^1.33.0",
    "@vue-flow/minimap": "^1.4.0",
    "@xterm/addon-fit": "^0.9.0",
    "@xterm/xterm": "^5.4.0",
    "cross-env": "^10.1.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.0",
    "npm-run-all": "^4.1.5",
    "pinia": "^2.1.7",
    "typescript": "^6.0.3",
    "vite": "^5.0.0",
    "vue": "^3.4.0",
    "vue-tsc": "^3.3.1",
    "wait-on": "^9.0.10"
  },
  "dependencies": {
    "@vue-flow/node-resizer": "^1.5.1",
    "node-pty": "^1.1.0"
  },
  "build": {
    "appId": "com.terminalcanvas.app",
    "productName": "Terminal Canvas",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
